# tap "heroku/brew"
tap "homebrew/bundle"
tap "homebrew/cask"
tap "homebrew/core"
tap "homebrew/services"

# tools
brew "git"
brew "neovim"
brew "tmux"

# # package + environment management
# brew "hashicorp/tap/terraform"
# brew "nodenv"
# brew "node-build"
# brew "pyenv"
# brew "rbenv"
# brew "ruby-build"
# brew "rust"
# brew "uv"

# cloud + platform
brew "awscli"
brew "gh"
# brew "heroku/brew/heroku"

# # databases + services
# brew "postgresql@18", restart_service: :changed, link: true
# brew "redis", restart_service: :changed

# terminal + utilities
brew "fzf"
brew "jq"
brew "reattach-to-user-namespace"
brew "ripgrep"
# brew "tree"
# brew "xq"
# brew "yq"

# applications
cask "1password"
cask "1password-cli"
cask "alacritty"
cask "font-sf-mono"
cask "slack"
cask "visual-studio-code"

# vscode extensions
vscode "editorconfig.editorconfig"
