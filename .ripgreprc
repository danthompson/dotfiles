--column
--follow
--hidden
--heading
--max-columns-preview
--max-columns=100
--smart-case
--line-number

--glob=!.git/*
--glob=!.pytest_cache
--glob=!.ruff_cache
--glob=!.ssh/
--glob=!.venv
--glob=!__pycache__
--glob=!node_modules
# --glob=.cache/*

