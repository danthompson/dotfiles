brew 'tflint'
brew 'tmux'
brew 'tree'
brew 'uv'
brew 'yamlfmt'
brew 'yamllint'
brew 'yarn'
brew 'yq'

cask '1password'
cask '1password-cli'
cask 'antigravity-cli'
