[user]
	name = Dan Thompson
	email = dwthompson@gmail.com

[github]
  user = danthompson

[credential]
  helper = osxkeychain

[apply]
  whitespace = nowarn

[core]
  editor = vim
  excludesfile = ~/.gitignore
  autocrlf = input

[merge]
	tool = opendiff

[push]
  default = current

[color]
  ui = auto

[color "branch"]
  current = green
  local = white
  remote = cyan

[color "diff"]
  meta = yellow
  frag = magenta
  old = red
  new = green

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[color "interactive"]
  header = white bold
  prompt = green bold
  help = cyan

[alias]
  a = add
  b = branch
  c = commit -v
  p = push
  cm = commit -m
  cl = clone
  xcl = "!f(){ u=$1; d=${u#*:}; d=${d%.git}; mkdir -p \"${d%/*}\"; git clone \"$u\" \"$d\"; }; f"
  co = checkout
  cp = cherry-pick
  d = diff
  dc = diff --cached
  l = log --graph --abbrev-commit --date=relative --decorate --all
  y = log --pretty=format:\"%C(green)%ad%Creset %C(yellow)%h%Creset - %s%C(red)%d%Creset\" --date=short --all --decorate --author=dwthompson@gmail.com
  yy = log --graph --abbrev-commit --date=relative --decorate -n 3 --pretty=format:"%B"
  re = rebase
  st = stash
  sub = submodule
  s = status -sb
  bp = !git branch --merged master | grep -v master | xargs git branch -d && git remote prune origin

  ; experimental
  ; stgr = "!f() { for i in `git stash list --format=\"%gd\"` ; do git stash show -p $i | grep -H --label=\"$i\" \"$@\" ; done ; }; f"
  ; churn = "!git log --format=format: --name-only --since='1 year ago' | sort | uniq -c | sort -nr | head -20" # what changes most
  ; who = shortlog -sn --no-merges # who built this, not root
  ; where = "!git log -i -E --grep='fix|bug|broken' --name-only --format='' | sort | uniq -c | sort -nr | head -20" # where issues cluster
  ; doppler = "!git log --format='%ad' --date=format:'%Y-%m' | sort | uniq -c" # acclerating or dying
  ; scramble = "!git log --oneline --since='1 year ago' | grep -iE 'revert|hotfix|emergency|rollback'" # firefighting

[format]
  pretty=format:%C(yellow)%h%Creset -%C(red)%d%Creset %s %Cgreen(%ad) %C(bold blue)<%an>%Creset
[heroku]
	account = personal
[filter "media"]
	required = true
	clean = git media clean %f
	smudge = git media smudge %f
[filter "hawser"]
	clean = git hawser clean %f
	smudge = git hawser smudge %f
	required = true
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[init]
	defaultBranch = main
